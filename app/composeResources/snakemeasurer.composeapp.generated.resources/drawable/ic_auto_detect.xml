<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- snake S-curve -->
  <path
      android:strokeWidth="2.5"
      android:strokeColor="#FFFFFF"
      android:fillColor="#00000000"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M6,20 C2,20 2,16 5,13 C8,10 14,11 15,8 C16,5 13,3 10,4"/>

  <!-- snake head dot -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M10,4 m-1.5,0 a1.5,1.5 0,1,0 3,0 a1.5,1.5 0,1,0 -3,0"/>

  <!-- Sparkle — single, larger, set apart in the top-right corner.
       Centre (20,4), rays reaching 3.8, waist at ~31% of the ray. That ratio is the whole shape: at
       the 66% this once had, the concavity was too shallow to read and the glyph looked like a plain
       diamond; much below ~25% the rays turn spindly at 24dp.
       3.8 is as long as the rays go: it leaves 0.2 inside the 24x24 canvas, and 4.1 would run off it
       and be clipped. The enclosing button is no constraint — it is a 52dp circle holding this icon
       at 24dp centred, so the corners of the icon box sit ~17dp from the centre against a 26dp
       radius. Growing further means moving the centre, not lengthening the rays. -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M20,0.2 L20.83,3.17 L23.8,4 L20.83,4.83 L20,7.8 L19.17,4.83 L16.2,4 L19.17,3.17 z"/>
</vector>
